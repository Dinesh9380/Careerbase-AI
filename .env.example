# Application Secrets & Configuration
PROJECT_NAME="AI-Based Skill Assessment and Career Guidance System"
VERSION="1.0.0"

# Security & Authentication
JWT_SECRET="super-secret-production-grade-key-change-in-prod-123456789"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (SQLite default for zero-friction local, or PostgreSQL)
DATABASE_URL="sqlite:///./career_platform.db"
# DATABASE_URL="postgresql://educareer_user:educareer_secure_password_2026@localhost:5432/career_platform"

# Redis Cache
REDIS_URL="redis://localhost:6379/0"

# Optional External AI LLM API Key (Falls back automatically to local intelligent RAG counselor if empty)
AI_API_KEY=""

# Blockchain RPC Node & Private Key (Ganache / Hardhat / EVM Testnet)
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
BLOCKCHAIN_CONTRACT_ADDRESS=""
BLOCKCHAIN_PRIVATE_KEY=""

# Computer Vision & OCR
OCR_CONFIG="--oem 3 --psm 6"
